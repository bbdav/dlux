---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  hideFooter={true}
>
  <section class="nf">
    <div class="wrap nf-inner">
      <p class="nf-code">404</p>
      <h1 class="nf-h">This page <em>drifted</em>.</h1>
      <p class="nf-sub">
        The thing you were after moved, or never existed. No harm done — here is the way back.
      </p>
      <div class="nf-actions">
        <a href="/" class="nf-btn" data-cursor>Back home</a>
        <a href="/work" class="nf-link" data-cursor>See the work →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .nf::before {
    content: '';
    position: absolute;
    width: 120%;
    height: 120%;
    top: -10%;
    left: -10%;
    background: radial-gradient(circle at 50% 45%, rgba(232, 254, 84, 0.06), transparent 45%);
    pointer-events: none;
  }
  .nf-inner {
    position: relative;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--color-accent-dim);
    margin-bottom: 28px;
  }
  .nf-h {
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.95;
    font-size: clamp(56px, 13vw, 180px);
  }
  .nf-h em {
    font-style: italic;
    color: var(--color-accent);
  }
  .nf-sub {
    margin-top: 28px;
    font-size: var(--text-lede);
    color: var(--color-fg-mid);
    max-width: 38ch;
    line-height: 1.55;
  }
  .nf-actions {
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .nf-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-bg);
    background: var(--color-accent);
    border-radius: 100px;
    padding: 13px 26px;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .nf-btn:hover {
    transform: translateY(-2px);
  }
  .nf-link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-fg-mid);
    border-bottom: 1px solid var(--color-fg-dim);
    padding-bottom: 4px;
    transition:
      color 0.25s,
      border-color 0.25s;
  }
  .nf-link:hover {
    color: var(--color-fg);
    border-color: var(--color-accent);
  }
</style>
