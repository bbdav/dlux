---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skills from '../components/Skills.astro';
import CTA from '../components/CTA.astro';

const beliefs = [
  {
    h: 'Systems over screens',
    p: 'A screen solves one problem once. A system solves a class of problems for everyone who comes after. I design for the second one.',
  },
  {
    h: 'Constraints are the brief',
    p: 'The interesting work lives inside real limits: legacy code, tight timelines, hardware that pushes back. I treat those as the shape of the problem, not an excuse.',
  },
  {
    h: 'Show the work',
    p: 'Good design survives a handoff. I document decisions, name things well, and leave a trail an engineer can build from without a single clarifying question.',
  },
  {
    h: 'Outcomes, not output',
    p: 'More artifacts is not more value. I measure a project by what changed for the people using it, not by how many screens I drew.',
  },
];
---

<BaseLayout
  title="About"
  description="David Babijaev — senior product designer with 20+ years across design systems, enterprise SaaS, mobile and IoT. HCI background, Toptal top 3%, based in the Greater Toronto Area."
>
  <section class="about-page sec-pad">
    <div class="wrap">
      <header class="ap-head rv">
        <p class="sec-tag">About</p>
        <h1 class="ap-lead">
          I turn complex software into products people <em>actually understand</em>.
        </h1>
      </header>

      <div class="ap-story">
        <div class="ap-col rv">
          <p>
            I am a senior product designer with more than twenty years of doing the work. My
            background is in HCI engineering at Technion, and I have spent the time since building
            design systems from scratch, shipping enterprise dashboards, and designing for iOS, IoT
            and SaaS.
          </p>
          <p>
            Right now I am a <strong>Senior Product Designer at OEC</strong>, working on collision
            repair tools where the people on the other end are busy, expert, and have no patience for
            a confusing interface. On the side I am designing <strong>Contengine</strong>, my own
            headless CMS, which keeps me honest about how design and engineering actually meet.
          </p>
          <p>
            I take Toptal contract work when the project is worth doing. I was screened into the
            <strong>top 3%</strong> of their design network, and I am equally at home embedded in a
            product team or running a piece of work end to end on my own.
          </p>
        </div>
        <aside class="ap-aside rv rv2">
          <dl class="ap-facts">
            <div><dt>Based</dt><dd>Bradford, ON · GTA · Eastern Time</dd></div>
            <div><dt>Experience</dt><dd>20+ years in product design</dd></div>
            <div><dt>Background</dt><dd>HCI engineering, Technion</dd></div>
            <div><dt>Now</dt><dd>Senior Product Designer, OEC</dd></div>
            <div><dt>Building</dt><dd>Contengine, a headless CMS</dd></div>
            <div><dt>Languages</dt><dd>English, Hebrew, Russian</dd></div>
          </dl>
        </aside>
      </div>

      <div class="ap-beliefs rv">
        <h2 class="ap-h2">How I work</h2>
        <ul class="beliefs">
          {
            beliefs.map((b) => (
              <li class="belief">
                <h3>{b.h}</h3>
                <p>{b.p}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ap-skills rv">
        <h2 class="ap-h2">What I bring</h2>
        <Skills />
      </div>

      <div class="ap-availability rv">
        <span class="avail-dot" aria-hidden="true"></span>
        <p>
          <strong>Available now</strong> for senior product design roles and select Toptal contract
          work.
        </p>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .about-page {
    padding-top: clamp(120px, 16vh, 200px);
  }
  .ap-head {
    margin-bottom: clamp(48px, 7vw, 96px);
  }
  .ap-lead {
    margin-top: 24px;
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1.05;
    font-size: clamp(34px, 6vw, 84px);
    max-width: 16ch;
  }
  .ap-lead em {
    font-style: italic;
    color: var(--color-accent);
  }

  .ap-story {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: clamp(40px, 7vw, 110px);
    align-items: start;
    margin-bottom: clamp(64px, 9vw, 130px);
  }
  .ap-col p {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.7;
    color: var(--color-fg-mid);
    margin-bottom: 1.2em;
    max-width: 60ch;
  }
  .ap-col strong {
    color: var(--color-fg);
    font-weight: 400;
  }

  .ap-facts {
    border-top: 1px solid var(--color-line);
  }
  .ap-facts > div {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .ap-facts dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }
  .ap-facts dd {
    font-size: 15px;
    color: var(--color-fg);
    margin: 0;
  }

  .ap-h2 {
    font-weight: 300;
    letter-spacing: -0.03em;
    font-size: var(--text-section);
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .ap-beliefs {
    margin-bottom: clamp(64px, 9vw, 130px);
  }
  .beliefs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .belief {
    background: var(--color-bg);
    padding: clamp(28px, 3vw, 44px);
  }
  .belief h3 {
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-fg);
    margin-bottom: 14px;
  }
  .belief p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-fg-mid);
  }

  .ap-skills {
    margin-bottom: clamp(64px, 9vw, 130px);
  }
  .ap-skills :global(.skills) {
    margin-top: 0;
  }

  .ap-availability {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: clamp(28px, 3vw, 40px);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-bg-soft);
  }
  .ap-availability p {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--color-fg-mid);
  }
  .ap-availability strong {
    color: var(--color-fg);
    font-weight: 400;
  }
  .avail-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    box-shadow: 0 0 0 0 var(--color-accent);
    animation: avail-ping 2.6s infinite;
  }
  @keyframes avail-ping {
    0% {
      box-shadow: 0 0 0 0 rgba(232, 254, 84, 0.5);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(232, 254, 84, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(232, 254, 84, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avail-dot {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .ap-story {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 680px) {
    .beliefs {
      grid-template-columns: 1fr;
    }
  }
</style>
