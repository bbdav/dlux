---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWork, disciplineOf } from '../../lib/work';
import { CATEGORIES } from '../../consts';

const projects = await getWork();

// Only show filters for categories that actually have projects.
const usedCategories = CATEGORIES.filter((c) => projects.some((p) => p.data.category === c));
---

<BaseLayout
  title="Work"
  description="Selected case studies — design systems, SaaS, mobile, IoT and e-commerce product design by David Babijaev."
>
  <section class="work-index sec-pad">
    <div class="wrap">
      <header class="work-header rv">
        <p class="sec-tag">Selected work</p>
        <h1 class="sec-title work-h1">Case <em>studies</em></h1>
        <p class="work-sub">
          Twenty years of shipped product work across design systems, SaaS, mobile, IoT and
          e-commerce.
        </p>
      </header>

      <div class="filters rv" role="group" aria-label="Filter projects by category">
        <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
          All <span class="filter-n">{projects.length}</span>
        </button>
        {
          usedCategories.map((c) => (
            <button type="button" class="filter" data-filter={c} aria-pressed="false">
              {c}
              <span class="filter-n">{projects.filter((p) => p.data.category === c).length}</span>
            </button>
          ))
        }
      </div>

      <p class="sr-only" aria-live="polite" id="filter-status"></p>

      <ul class="work-grid" id="work-grid">
        {
          projects.map((p) => (
            <li class="card" data-category={p.data.category}>
              <a href={`/work/${p.id}`} data-cursor>
                <div class="card-media">
                  <span class="card-arrow" aria-hidden="true">↗</span>
                  <Picture
                    src={p.data.cover}
                    alt={p.data.coverAlt}
                    formats={['webp']}
                    widths={[400, 600, 800, 1000]}
                    sizes="(min-width: 900px) 45vw, 100vw"
                    class="card-img"
                  />
                </div>
                <div class="card-meta">
                  <h2 class="card-name">{p.data.title}</h2>
                  <p class="card-client">{p.data.client}</p>
                  <p class="card-tags">
                    {disciplineOf(p)} · {p.data.year}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .work-index {
    padding-top: clamp(120px, 16vh, 200px);
  }
  .work-header {
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .work-h1 {
    margin-top: 18px;
  }
  .work-sub {
    margin-top: 24px;
    font-size: var(--text-lede);
    color: var(--color-fg-mid);
    max-width: 46ch;
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---- filter bar ---- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: clamp(28px, 3vw, 40px);
  }
  .filter {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--color-fg-mid);
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 100px;
    padding: 9px 16px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition:
      color 0.25s,
      border-color 0.25s,
      background 0.25s;
  }
  .filter:hover {
    color: var(--color-fg);
    border-color: var(--color-fg-dim);
  }
  .filter.is-active {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .filter-n {
    font-size: 10px;
    opacity: 0.7;
  }

  /* ---- editorial grid ---- */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 56px) clamp(20px, 3vw, 40px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Offset every second card for an editorial rhythm */
  .card:nth-child(even) {
    margin-top: clamp(0px, 6vw, 80px);
  }
  .card.is-hidden {
    display: none;
  }
  .card a {
    display: block;
  }
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out-expo);
  }
  .card a:hover .card-img,
  .card a:focus-visible .card-img {
    transform: scale(1.04);
  }
  .card-arrow {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    opacity: 0;
    transform: scale(0.7) rotate(-30deg);
    transition:
      opacity 0.4s,
      transform 0.4s;
  }
  .card a:hover .card-arrow,
  .card a:focus-visible .card-arrow {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
  .card-meta {
    margin-top: 20px;
  }
  .card-name {
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .card-client {
    margin-top: 4px;
    font-size: 15px;
    color: var(--color-fg-mid);
  }
  .card-tags {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--color-fg-dim);
    text-transform: uppercase;
  }

  @media (max-width: 680px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
    .card:nth-child(even) {
      margin-top: 0;
    }
  }
</style>

<script>
  const grid = document.getElementById('work-grid');
  const status = document.getElementById('filter-status');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));

  if (grid && buttons.length) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));

    const apply = (filter: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.classList.toggle('is-hidden', !match);
        if (match) shown++;
      });
      buttons.forEach((b) => {
        const active = b.dataset.filter === filter;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-pressed', String(active));
      });
      if (status) {
        status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}${
          filter === 'all' ? '' : ` in ${filter}`
        }.`;
      }
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter || 'all')));
  }
</script>
