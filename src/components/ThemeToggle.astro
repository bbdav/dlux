---
/**
 * Light/dark theme switcher. Reads/writes localStorage('theme') and flips
 * data-theme on <html>. The no-flash init lives in BaseHead so the correct
 * theme is set before first paint; this only handles the click + sync.
 * Colour inherits from the parent so it works under the nav's blend mode
 * and inside the (un-blended) mobile menu alike.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  aria-label="Switch to light theme"
  title="Toggle theme"
>
  <svg
    class="ico ico-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M4.5 4.5l1.4 1.4M18.1 18.1l1.4 1.4M2.5 12h2M19.5 12h2M4.5 19.5l1.4-1.4M18.1 5.9l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="ico ico-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    border-radius: 50%;
    transition: opacity 0.25s;
    opacity: 0.85;
  }
  .theme-toggle:hover {
    opacity: 1;
  }
  .ico {
    width: 18px;
    height: 18px;
    display: block;
  }
  /* Dark (default): sun visible. Light: moon visible. */
  .ico-moon {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle .ico-sun {
    display: none;
  }
  :global([data-theme='light']) .theme-toggle .ico-moon {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;

  const syncLabels = (t: string) => {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
      b.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
    });
  };

  const apply = (t: 'light' | 'dark') => {
    root.dataset.theme = t;
    try {
      localStorage.setItem('theme', t);
    } catch {}
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', t === 'light' ? '#F4F3F0' : '#0B0B0C');
    syncLabels(t);
  };

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) =>
    b.addEventListener('click', () => apply(root.dataset.theme === 'light' ? 'dark' : 'light'))
  );

  // Match labels + browser chrome to whatever the pre-paint script already set.
  {
    const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
    syncLabels(current);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', current === 'light' ? '#F4F3F0' : '#0B0B0C');
  }
</script>
