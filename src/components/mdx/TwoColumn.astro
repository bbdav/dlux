---
// Two-column editorial block. Stacks to a single column under 720px.
// Usage in MDX:
//   <TwoColumn>
//     <Fragment slot="left"> ...markdown... </Fragment>
//     <Fragment slot="right"> ...markdown... </Fragment>
//   </TwoColumn>
---

<div class="twocol u-wide">
  <div class="col"><slot name="left" /></div>
  <div class="col"><slot name="right" /></div>
</div>

<style>
  .twocol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    margin-block: clamp(32px, 5vw, 56px);
    align-items: start;
  }
  /* Tighten typography inside columns so they read as one unit */
  .col :global(> :first-child) {
    margin-top: 0;
  }
  .col :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-fg-mid);
  }
  @media (max-width: 720px) {
    .twocol {
      grid-template-columns: 1fr;
    }
  }
</style>
