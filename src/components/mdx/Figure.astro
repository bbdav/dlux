---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="fig media">
  <div class="fig-frame scrollwrap">
    <div class="fig-scroll scrollwrap-area">
      <Image
        src={src}
        alt={alt}
        widths={[768, 1200, 1600]}
        sizes="(min-width: 1200px) 1200px, 100vw"
        format="webp"
        class="fig-img"
      />
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin-block: clamp(36px, 5vw, 72px);
  }
  /* Image fills its box at native aspect ratio — no letterboxing. If it's
     taller than the viewport it scrolls inside the frame (custom overlay
     scrollbar), then the page scrolls. */
  .fig-frame {
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-bg-soft);
    overflow: hidden;
  }
  .fig-scroll {
    max-height: 100vh;
  }
  .fig-img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--color-fg-dim);
    text-align: center;
  }
</style>
