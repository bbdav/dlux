---
import { Picture } from 'astro:assets';

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  items: GalleryItem[];
  /** Columns on desktop (2 or 3). Always 1 on mobile. */
  cols?: 2 | 3;
  caption?: string;
}

const { items, cols = 2, caption } = Astro.props;
---

<div class="gallery u-wide" data-cols={cols}>
  <div class="gallery-grid">
    {
      items.map((it) => (
        <Picture
          src={it.src}
          alt={it.alt}
          formats={['webp']}
          widths={[400, 600, 900]}
          sizes={`(min-width: 720px) ${Math.round(100 / cols)}vw, 100vw`}
          class="gallery-img"
        />
      ))
    }
  </div>
  {caption && <p class="gallery-cap">{caption}</p>}
</div>

<style>
  .gallery {
    margin-block: clamp(32px, 5vw, 64px);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .gallery[data-cols='2'] .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .gallery[data-cols='3'] .gallery-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .gallery-cap {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--color-fg-dim);
    text-align: center;
  }
  @media (max-width: 680px) {
    .gallery[data-cols='2'] .gallery-grid,
    .gallery[data-cols='3'] .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
