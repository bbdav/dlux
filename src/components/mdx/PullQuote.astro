---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<blockquote class="pullquote u-wide">
  <p><slot /></p>
  {cite && <cite>{cite}</cite>}
</blockquote>

<style>
  .pullquote {
    margin-block: clamp(48px, 7vw, 88px);
    text-align: center;
  }
  .pullquote p {
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.18;
    font-size: clamp(24px, 3.4vw, 40px);
    color: var(--color-fg);
    max-width: 20ch;
    margin-inline: auto;
  }
  .pullquote p::before {
    content: '';
    display: block;
    width: 32px;
    height: 2px;
    background: var(--color-accent);
    margin: 0 auto clamp(24px, 3vw, 36px);
  }
  cite {
    display: block;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-fg-dim);
  }
</style>
